{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 150,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/public/**",
    "**/legacy/**",
    "**/.internal/**",
    "**/metadata.ts",
    "**/swagger.json",
    "**/packages/backend/src/core/database/drizzle/meta/**",
    "docs/**",
    "cli/**"
  ]
}
