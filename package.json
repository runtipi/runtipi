{
  "name": "runtipi",
  "version": "4.1.0",
  "description": "",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "catalog": {
      "arktype": "^2.1.29"
    },
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "bundle": "turbo bundle",
    "build": "turbo run build",
    "tsc": "bun run typecheck",
    "test": "turbo test",
    "test:integration": "turbo run test:integration",
    "start": "node ./main.js",
    "start:dev": "docker compose --project-name runtipi -f docker-compose.dev.yml up --build",
    "start:dev:portless": "bash ./scripts/start-dev-portless.sh",
    "start:prod": "docker compose --project-name runtipi -f docker-compose.prod.yml up --build",
    "test:e2e": "NODE_ENV=test dotenv -e .env -e .env.e2e -- playwright test",
    "test:e2e:ui": "NODE_ENV=test dotenv -e .env -e .env.e2e -- playwright test --ui",
    "gen:api-client": "openapi-ts",
    "lint:ci": "bun run format:check && bun run lint --deny-warnings",
    "lint": "bun run --bun oxlint",
    "version": "echo $npm_package_version",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check --changed=${FORMAT_BASE:-origin/develop}",
    "lint:fix": "bun run lint --fix",
    "typecheck": "turbo run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "GNU General Public License v3.0",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.1.0",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "oxlint": "^1.90.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "overrides": {
    "arktype": "^2.2.9"
  }
}
