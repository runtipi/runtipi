{
  "name": "runtipi",
  "version": "4.1.0",
  "description": "",
  "keywords": [],
  "license": "GNU General Public License v3.0",
  "author": "",
  "workspaces": {
    "catalog": {
      "arktype": "^2.1.29"
    },
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "bundle": "turbo bundle",
    "build": "turbo run build",
    "tsc": "turbo run tsc",
    "test": "turbo test",
    "test:integration": "turbo run test:integration",
    "start": "node ./main.js",
    "start:dev": "docker compose --project-name runtipi -f docker-compose.dev.yml up --build",
    "start:dev:portless": "bash ./scripts/start-dev-portless.sh",
    "start:prod": "docker compose --project-name runtipi -f docker-compose.prod.yml up --build",
    "test:e2e": "NODE_ENV=test dotenv -e .env -e .env.e2e -- playwright test",
    "test:e2e:ui": "NODE_ENV=test dotenv -e .env -e .env.e2e -- playwright test --ui",
    "gen:api-client": "openapi-ts",
    "lint:ci": "oxlint . --quiet --no-error-on-unmatched-pattern && oxfmt --check \"**/*.{js,jsx,ts,tsx,json,jsonc,css}\" --no-error-on-unmatched-pattern",
    "lint": "oxlint . --quiet && oxfmt --check \"**/*.{js,jsx,ts,tsx,json,jsonc,css}\"",
    "lint:fix": "oxlint . --fix && oxfmt --write \"**/*.{js,jsx,ts,tsx,json,jsonc,css}\"",
    "version": "echo $npm_package_version"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.52.0",
    "@types/bun": "^1.2.22",
    "@types/pg": "^8.15.1",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.0.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.5.6"
  },
  "overrides": {
    "arktype": "^2.1.29"
  },
  "packageManager": "bun@1.3.0"
}
